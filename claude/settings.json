{
  "env": {
    "DD_API_KEY": "${DD_API_KEY}",
    "DD_APP_KEY": "${DD_APP_KEY}",
    "DD_SITE": "zillow.datadoghq.com"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git * && git *)",
      "Bash(git * && git * && git *)",
      "Bash(glab *)",
      "Bash(gh *)",
      "Bash(./gradlew *)",
      "Bash(gradle *)",
      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(java *)",
      "Bash(aws *)",
      "Bash(jq *)",
      "Bash(curl *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(terraform *)",
      "Bash(afplay *)",
      "mcp__context7__*",
      "mcp__ws-expert-mcp__*",
      "mcp__zgtools-mcp-server__*",
      "mcp__glean_default__*",
      "mcp__plugin_mercury-backend-core-plugin_context7__*",
      "Bash(atlas:*)",
      "Bash(python3:*)",
      "WebFetch(domain:docs.zgtools.net)",
      "WebFetch(domain:studio.apollographql.com)",
      "Read",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(rm -r /*)"
    ],
    "additionalDirectories": [
      "~/code",
      "~"
    ]
  },
  "model": "sonnet",
  "outputStyle": "Terse",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/dorianr/.claude/hooks/block-gdocs-writes.sh",
            "if": "Bash(curl *)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff & osascript -e 'display notification \"Task finished\" with title \"Claude Code\"'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Submarine.aiff & osascript -e 'display notification \"Permission needed\" with title \"Claude Code\"'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/dorianr/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "mercury-backend-core-plugin@mercury-backend-plugins": true,
    "mattpocock-skills@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "effortLevel": "high",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}
